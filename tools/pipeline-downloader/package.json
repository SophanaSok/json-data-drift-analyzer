{
  "name": "pipeline-downloader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Manual-run Playwright prototype that downloads one JSON export from the internal pipeline dashboard.",
  "scripts": {
    "download": "node --env-file-if-exists=.env src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.54.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
