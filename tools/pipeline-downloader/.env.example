# Copy to .env (gitignored) or export these in your shell before running.
# Values below are placeholders — never commit real credentials.

# Base URL of the internal dashboard, scheme included. https is strongly preferred:
# the tool warns on plain http because the login below is sent over that connection.
PIPELINE_DASHBOARD_URL=https://dashboard.internal.example

PIPELINE_USERNAME=your.name@example.com
PIPELINE_PASSWORD=replace-me
